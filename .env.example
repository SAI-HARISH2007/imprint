# Imprint service configuration. Copy to .env and edit; all values are optional.
# The defaults point at the live Monad testnet registry, so a bare checkout runs read-only.

# --- chain ---
IMPRINT_RPC=https://testnet-rpc.monad.xyz
IMPRINT_CHAIN_ID=10143
IMPRINT_REGISTRY=0xf4a792ddb0c83Bdf1Ed2E1220B197760d821396c
IMPRINT_DEPLOY_BLOCK=69296432
IMPRINT_EXPLORER=https://testnet.monadvision.com
# Seconds to cache the registry record count (fewer RPC calls under load).
IMPRINT_COUNT_TTL=10

# --- relayer (required only for registration; read/check endpoints work without it) ---
# Testnet-only wallet. Prefer the file form so the key never lands in the environment.
# IMPRINT_RELAYER_KEY=0x...
# IMPRINT_RELAYER_KEY_FILE=~/.imprint/deployer.json

# --- limits (0 disables a limit) ---
IMPRINT_PER_IP_ATTEMPTS_HOUR=30
IMPRINT_PER_IP_HOUR=12
IMPRINT_GLOBAL_DAY=150
IMPRINT_HEAVY_PER_MIN=20
IMPRINT_MAX_BUSY=2

# --- abuse / proxy handling ---
# Comma-separated allowlist of reverse proxies whose X-Forwarded-For we trust, or "*".
IMPRINT_TRUSTED_PROXIES=*
# Which hop of X-Forwarded-For is the client, counting from the right.
IMPRINT_XFF_HOPS=1
# CORS origins for the browser client (comma-separated, or "*").
IMPRINT_CORS_ORIGINS=*

# --- diagnostics ---
# Relayer balance below this (in wei) is flagged by GET /status.
IMPRINT_LOW_BALANCE_WEI=500000000000000000
